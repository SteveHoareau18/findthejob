# Configuration du serveur
PORT=3000

# Clé API Groq (obtenez-en une gratuitement sur https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Modèle Groq recommandé
GROQ_MODEL=llama-3.3-70b-versatile

# Clé API Jooble (Optionnelle - obtenez-en une gratuitement en 30s sur https://jooble.org/api/about)
JOOBLE_API_KEY=
